   "y": 7175,
   "page": "v7"
  },
  "v7row6": {
   "kind": "title1",
   "maxW": 7000,
   "text": "7. Farm: USDC or SOL Kamino pool, any stock as collateral, leverage, deploy; then Position, close in two approvals, and Position History",
